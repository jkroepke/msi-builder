<?xml version="1.0" encoding="UTF-8"?>
<!-- A sample package whose quiet exec actions share one command line
     property, set right before each of them. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Hello" Manufacturer="Example" Version="1.0.0" UpgradeCode="0b7e8c41-2f6d-4a39-8c15-7d2e9f0a6b54" InstallerVersion="500">
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Hello" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenu" Name="Hello" />
    </StandardDirectory>
    <Property Id="CONSOLEURL" Value="http://localhost:4985/" />

    <ComponentGroup Id="Main" Directory="INSTALLFOLDER">
      <Component Id="HelloExe" Subdirectory="bin">
        <File Id="readme.txt" Source="dist\readme.txt" />
        <File Id="hello.exe" Source="dist\hello.exe" KeyPath="yes" />
        <!-- Advertised: becomes a plain shortcut to the component's key file. -->
        <Shortcut Id="AdvLink" Name="Hello" Directory="AppMenu" Advertise="yes" />
        <ServiceInstall Name="HelloSvc" Start="auto" Type="ownProcess" ErrorControl="normal">
          <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="none" />
        </ServiceInstall>
        <util:RemoveFolderEx Property="INSTALLFOLDER" On="uninstall" />
      </Component>
      <!-- Controls the service of another component. -->
      <Component Id="HelloSvcControl" Condition="&amp;Complete = 3">
        <File Id="hello.yaml" Source="dist\hello.yaml" />
        <ServiceControl Id="HelloSvcStart" Name="HelloSvc" Start="install" Stop="both" Remove="uninstall" />
      </Component>
      <!-- A second control of the same service, whose events are merged. -->
      <Component Id="HelloSvcRestart">
        <File Id="hello.ini" Source="dist\hello.ini" />
        <ServiceControl Id="HelloSvcRestart" Name="HelloSvc" Stop="install" Start="install" />
      </Component>
      <!-- Installs the same service for another edition, with its own control. -->
      <Component Id="HelloSvcLite" Condition="EDITION=&quot;lite&quot;">
        <File Id="hello_lite.exe" Source="dist\hello-lite.exe" />
        <ServiceInstall Name="HelloSvc" Start="demand" Type="ownProcess" ErrorControl="normal" />
        <ServiceControl Id="HelloSvcLite" Name="HelloSvc" Stop="both" Remove="uninstall" />
      </Component>
      <!-- The key file has no Id; the advertised shortcut starts it. -->
      <Component Id="Tray">
        <File Source="dist\helper.dll" />
        <File Source="dist\tray.exe" KeyPath="yes" />
        <Shortcut Id="TrayLink" Name="Hello Tray" Directory="AppMenu" Advertise="yes" />
      </Component>
      <!-- An & in a string is no action state. -->
      <Component Id="RnD" Condition="EDITION=&quot;R&amp;D&quot;">
        <File Id="rnd.txt" Source="dist\rnd.txt" />
      </Component>
    </ComponentGroup>

    <Component Id="ConsoleLink" Directory="AppMenu">
      <!-- The target is a property that holds a URL, not a folder. -->
      <Shortcut Id="ConsoleShortcut" Name="Hello Console" Target="[CONSOLEURL]" />
      <RemoveFolder Id="RemoveAppMenu" On="uninstall" />
      <!-- Removed on uninstall only, never created. -->
      <RemoveRegistryKey Root="HKCR" Key="*\shell\Hello" Action="removeOnUninstall" />
      <RemoveRegistryValue Root="HKCU" Key="Software\Example\Hello" />
      <RegistryValue Root="HKCU" Key="Software\Example\Hello\Handlers" Name="PlayMedia" Type="string" Value="" />
      <RegistryValue Root="HKCU" Key="Software\Example\Hello" Name="console" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Complete">
      <ComponentGroupRef Id="Main" />
      <ComponentRef Id="ConsoleLink" />
    </Feature>

    <!-- Three immediate quiet exec actions, each with its own command. -->
    <CustomAction Id="SetStopCmd" Property="WixQuietExecCmdLine" Value="&quot;[System64Folder]taskkill.exe&quot; /im hello.exe /f" />
    <CustomAction Id="StopHello" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_X64" Execute="immediate" Return="ignore" />
    <CustomAction Id="SetGreetCmd" Property="WixQuietExecCmdLine" Value="&quot;[System64Folder]cmd.exe&quot; /c echo hello" />
    <CustomAction Id="Greet" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_X64" Execute="immediate" Return="ignore" />
    <SetProperty Id="WixQuietExecCmdLine" Value="&quot;[#hello.exe]&quot; cleanup" Before="Cleanup" Sequence="execute" />
    <CustomAction Id="Cleanup" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_X64" Execute="immediate" Return="ignore" />

    <!-- A deferred one gets its command through CustomActionData. -->
    <SetProperty Id="Register" Value="&quot;[#hello.exe]&quot; register" Before="Register" Sequence="execute" />
    <CustomAction Id="Register" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_X64" Execute="deferred" Impersonate="no" Return="check" />

    <!-- Started without waiting for it, and an error with its own message. -->
    <CustomAction Id="StartTray" FileRef="hello.exe" ExeCommand="--tray" Execute="immediate" Return="asyncNoWait" />
    <CustomAction Id="StartMonitor" Directory="INSTALLFOLDER" ExeCommand="[MONITOR] --monitor" Return="asyncNoWait" />
    <CustomAction Id="NeedsAdmin" Error="25000" />
    <!-- Placed on actions of a WiX extension. -->
    <CustomAction Id="Configure" FileRef="hello.exe" ExeCommand="--configure" Execute="deferred" Impersonate="no" />
    <CustomAction Id="UndoConfigure" FileRef="hello.exe" ExeCommand="--unconfigure" Execute="rollback" Impersonate="no" />
    <SetProperty Id="CLOSING" Value="1" Before="Wix4CloseApplications_X64" Sequence="execute" />
    <UI>
      <Error Id="25000">Hello needs administrator rights.</Error>
      <Error Id="1316">A file is missing.</Error>
    </UI>

    <InstallExecuteSequence>
      <Custom Action="NeedsAdmin" After="LaunchConditions" Condition="NOT Privileged" />
      <Custom Action="StartTray" After="InstallFinalize" Condition="NOT REMOVE" />
      <Custom Action="StartMonitor" After="StartTray" Condition="NOT REMOVE" />
      <Custom Action="SetStopCmd" Before="StopHello" />
      <Custom Action="StopHello" After="Wix4CloseApplications_X64" />
      <Custom Action="SetGreetCmd" After="InstallFinalize" />
      <Custom Action="Greet" After="SetGreetCmd" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="Cleanup" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="Register" After="InstallFiles" Condition="NOT Installed" />
      <Custom Action="UndoConfigure" Before="Wix4ExecFirewallExceptionsInstall_X64" Condition="NOT Installed" />
      <Custom Action="Configure" After="Wix4ExecFirewallExceptionsInstall_X64" Condition="NOT Installed" />
    </InstallExecuteSequence>
  </Package>
</Wix>

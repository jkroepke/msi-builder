<?xml version="1.0" encoding="UTF-8"?>
<!-- A dual-scope sample whose components install in one scope only. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?define MainLevel = "1" ?>
  <Package Name="Hello" Manufacturer="Example" Version="1.0.0" UpgradeCode="3f2504e0-4f89-41d3-9a0c-0305e82c3301" Scope="perUserOrMachine">
    <MajorUpgrade DowngradeErrorMessage="newer" />
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Hello" />
    </StandardDirectory>
    <Feature Id="DefaultFeature" ConfigurableDirectory="INSTALLFOLDER" AllowAbsent="no" Level="$(var.MainLevel)">
      <Component Directory="INSTALLFOLDER"><File Source="hello.exe" /></Component>
      <Component Directory="INSTALLFOLDER" Condition="ALLUSERS=1">
        <RegistryValue Root="HKLM" Key="Software\Example\Hello" Name="InstalledBy" Value="msi" KeyPath="yes" />
        <Environment Id="PathM" Name="PATH" Value="[INSTALLFOLDER]" Part="last" System="yes" Action="set" />
      </Component>
      <Component Directory="INSTALLFOLDER" Condition="ALLUSERS">
        <RegistryValue Root="HKLM" Key="Software\Example\Hello" Name="Machine" Value="1" KeyPath="yes" />
      </Component>
      <Component Directory="INSTALLFOLDER" Condition="NOT ALLUSERS=1">
        <Environment Id="PathU" Name="PATH" Value="[INSTALLFOLDER]" Part="last" System="no" Action="set" />
        <RegistryValue Root="HKCU" Key="Software\Example\Hello" Name="u" Value="1" KeyPath="yes" />
      </Component>
    </Feature>

    <!-- The scope page of WixUI_Advanced; msi-builder picks the folders itself. -->
    <ui:WixUI Id="WixUI_Advanced" />
    <CustomAction Id="OverridePerMachineFolder" Property="WixPerMachineFolder" Value="[ProgramFiles64Folder][ApplicationFolderName]" />
    <InstallUISequence>
      <Custom Action="OverridePerMachineFolder" After="WixSetDefaultPerMachineFolder" />
    </InstallUISequence>
    <CustomAction Id="OverrideAgain" Property="WixPerMachineFolder" Value="[ProgramFiles64Folder]Example\Hello" />
    <!-- Placed on left-out setters, so they move to those setters' place. -->
    <SetProperty Id="HELLOMODE" Value="dual" After="OverrideAgain" Sequence="execute" />
    <SetProperty Id="UIMODE" Value="dual" After="OverrideAgain" />
    <!-- Elevated actions run only per machine in msi-builder (CA-09). -->
    <CustomAction Id="RegisterMachine" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]hello.exe&quot; --register" Execute="deferred" Impersonate="no" />
    <CustomAction Id="RegisterGuarded" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]hello.exe&quot; --guarded" Execute="deferred" Impersonate="no" />
    <CustomAction Id="ElevatedUser" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]hello.exe&quot; --elevated-user" Execute="deferred" Impersonate="no" />
    <CustomAction Id="SetupUser" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]hello.exe&quot; --user" Execute="deferred" />
    <!-- Scheduled in the UI sequence too, so it keeps its conditions. -->
    <CustomAction Id="SetMode" Property="HELLOMACHINE" Value="1" />
    <InstallUISequence>
      <Custom Action="SetMode" After="CostFinalize" Condition="ALLUSERS=1" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="SetMode" After="CostFinalize" Condition="ALLUSERS=1" />
      <Custom Action="RegisterMachine" After="InstallFiles" Condition="NOT Installed" />
      <Custom Action="RegisterGuarded" After="InstallFiles" Condition="ALLUSERS=1" />
      <Custom Action="ElevatedUser" After="InstallFiles" Condition="NOT ALLUSERS" />
      <Custom Action="SetupUser" After="InstallFiles" Condition="NOT ALLUSERS" />
      <Custom Action="OverridePerMachineFolder" After="WixSetDefaultPerMachineFolder" />
      <Custom Action="OverrideAgain" After="OverridePerMachineFolder" />
      <RemoveExistingProducts After="InstallValidate" Condition="NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>

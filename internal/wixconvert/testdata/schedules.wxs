<?xml version="1.0" encoding="UTF-8"?>
<!-- A sample package whose command line setters run in several sequences,
     with a firewall rule, a wizard without its license page and data that
     a SetDirectory moves. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Hello" Manufacturer="Example" Version="1.0.0" UpgradeCode="0b7e8c41-2f6d-4a39-8c15-7d2e9f0a6b54">
    <MajorUpgrade DowngradeErrorMessage="A newer version is installed." />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Hello" />
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DataRoot" Name="Hello">
        <Directory Id="DataDir" Name="data" />
      </Directory>
    </StandardDirectory>
    <SetDirectory Id="DataRoot" Value="[%ProgramData]\Hello" />

    <Component Id="HelloExe" Directory="INSTALLFOLDER">
      <File Id="hello.exe" Source="dist\hello.exe">
        <!-- No Protocol: the rule is not limited to TCP. -->
        <fw:FirewallException Id="HelloAll" Name="Hello" Scope="any" />
        <fw:FirewallException Id="HelloPort" Name="Hello port" Port="8080" Scope="any" IgnoreFailure="yes" />
      </File>
      <ServiceInstall Name="HelloSvc" Start="auto" Type="ownProcess" ErrorControl="normal">
        <util:PermissionEx User="Everyone" ServiceQueryStatus="yes" ServiceInterrogate="yes" ServiceStart="yes" />
      </ServiceInstall>
    </Component>
    <Component Id="Data" Directory="DataDir" Guid="6a0f1c2e-7d3b-4e58-9a61-2b4c8d0e1f37">
      <CreateFolder />
      <util:RemoveFolderEx Property="DataDir" On="uninstall" />
    </Component>
    <Feature Id="Complete">
      <ComponentRef Id="HelloExe" />
      <ComponentRef Id="Data" />
    </Feature>

    <!-- SetProperty with its own action name. -->
    <SetProperty Id="WixQuietExecCmdLine" Action="SetStopCmd" Value="&quot;[#hello.exe]&quot; stop" Before="InstallValidate" Sequence="execute" />
    <CustomAction Id="StopHello" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_X64" Execute="immediate" Return="ignore" />
    <SetProperty Id="WixQuietExecCmdLine" Action="SetCleanCmd" Value="&quot;[#hello.exe]&quot; clean" After="InstallInitialize" Sequence="execute" />
    <CustomAction Id="Clean" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_X64" Execute="immediate" Return="ignore" />
    <!-- A setter in both sequences; the action follows its execute entry. -->
    <CustomAction Id="SetCheckCmd" Property="WixQuietExecCmdLine" Value="&quot;[#hello.exe]&quot; check" />
    <CustomAction Id="Check" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_X64" Execute="immediate" Return="ignore" />
    <!-- Sequence numbers count per sequence. -->
    <CustomAction Id="SetUiCmd" Property="WixQuietExecCmdLine" Value="&quot;[#hello.exe]&quot; ui" />
    <CustomAction Id="UiProbe" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_X64" Execute="immediate" Return="ignore" />
    <CustomAction Id="SetLateCmd" Property="WixQuietExecCmdLine" Value="&quot;[#hello.exe]&quot; late" />
    <CustomAction Id="Late" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_X64" Execute="immediate" Return="ignore" />
    <!-- No setter is scheduled right before this one. -->
    <CustomAction Id="Orphan" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_X64" Execute="immediate" Return="ignore" />

    <InstallUISequence>
      <Custom Action="SetCheckCmd" After="CostFinalize" />
      <Custom Action="SetUiCmd" Sequence="1400" />
      <Custom Action="UiProbe" Sequence="1401" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="StopHello" After="SetStopCmd" />
      <Custom Action="Clean" After="SetCleanCmd" />
      <Custom Action="SetCheckCmd" After="InstallFinalize" />
      <Custom Action="Check" After="SetCheckCmd" />
      <Custom Action="SetLateCmd" Sequence="6610" />
      <Custom Action="Late" Sequence="6620" />
      <Custom Action="Orphan" Before="InstallFinalize" />
      <!-- Starts the program after a quiet update, too. -->
      <Custom Action="LaunchHello" After="InstallFinalize" Condition="AUTOLAUNCH AND NOT Installed" />
    </InstallExecuteSequence>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="assets\license.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start Hello" />
    <CustomAction Id="LaunchHello" FileRef="hello.exe" ExeCommand="[LAUNCHARGS]" Return="asyncNoWait" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchHello"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
      <!-- Skip the license page. -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="1" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="1" />
    </UI>
  </Package>
</Wix>
